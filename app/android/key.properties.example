# 이 파일을 android/key.properties 로 복사해 값을 채운다. key.properties 는 git 에 올리지 않는다(.gitignore).
# 키스토어(.jks)는 레포 밖에 두고, 잃어버리지 않게 팀 금고(1Password 등)에 백업한다.
# 만드는 법: docs/play-release/README.md
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/절대/경로/wishkit-upload.jks

# AdMob 앱 ID 는 여기가 아니라 android/gradle.properties 의 admobAndroidAppId 에 넣는다(비밀값이 아님).
